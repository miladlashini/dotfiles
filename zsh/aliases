########################################
# system / packages
########################################
alias agi="sudo apt install"
alias update="sudo apt update"
alias upgrade="sudo apt upgrade"
alias fix_update="sudo apt-get update --fix-missing"
alias agr="sudo apt-get remove --purge"
alias up="update_script.sh"

########################################
# shell / file utilities
########################################
alias -g G="| grep"
alias -g L="| less"
alias mmo="sudo chown -R $USER:$USER "
alias chm="chmod a+x "
alias lh="ls -lhrta"
alias skey="ssh-keygen -t rsa"
# single-quoted so $PATH is read fresh every time, not baked in from
# whatever it was when this file was sourced at shell startup.
alias path='echo $PATH'

########################################
# git
########################################
# Repairs a force-push rejected with "stale info" on a secondary remote.
# Background: origin has two push URLs (github + FamilyCloud) but fetches
# only from github, so plain `--force-with-lease` checks FamilyCloud
# against github's state and rejects whenever the two servers drift apart.
# This fetches the remote's REAL state first, then force-pushes the current
# branch with the lease pinned to exactly that - so it can never clobber
# anything it hasn't just seen.
force_push_lease() {
    local remote="${1:-familycloud}" branch
    branch="$(git rev-parse --abbrev-ref HEAD)" || return 1
    git fetch "$remote" || return 1
    git push "$remote" "$branch" --force-with-lease="$branch:$remote/$branch"
}

########################################
# machine-local overrides
########################################
# aliases2 is gitignored on purpose - put anything here that's specific to
# this machine and shouldn't be shared to the others via this repo.
[ -f "${DOTFILES}/zsh/aliases2" ] && source "${DOTFILES}/zsh/aliases2"
