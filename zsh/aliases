# aliases - general shell ergonomics: the small, everyday things that work
# on any machine and belong to no particular domain. Sourced by .zshrc.
#
# Domain-specific helpers live in their own files alongside this one and
# are listed in .zshrc's aliases_files array: system-aliases, git-aliases,
# debug-aliases, network-aliases, tmux-aliases, rpc-build-aliases, yocto.
# Machine-specific additions that shouldn't be shared belong in aliases2
# (see the bottom of this file) - that file is gitignored on purpose.
#
# Naming: everything below is lower_snake_case, matching install.sh,
# zsh/yocto, and scripts/Bash/history-sync - the convention the Google
# Shell Style Guide recommends and the one already dominant in this repo.
# Exception: the global aliases (`alias -g`) stay UPPERCASE on purpose,
# since that's the standard zsh idiom for making them visually stand out
# anywhere in a command line, not just as the first word.

########################################
# bluetooth keyboard (reference notes, not aliases)
########################################
# For the bluetooth keyboard to be available at login:
#   sudo snap install bluetooth-autostart
#   bluetoothctl
#     trust DC:2C:26:0A:7E:69
#     info  DC:2C:26:0A:7E:69

########################################
# shell / file utilities
########################################
alias -g G="| grep"
alias -g L="| less"
alias mmo="sudo chown -R $USER:$USER "
alias chm="chmod a+x "
alias lh="ls -lhrta"
alias skey="ssh-keygen -t rsa"
# single-quoted so $PATH is read fresh every time, not baked in from
# whatever it was when this file was sourced at shell startup.
alias path='echo $PATH'

# navigate the filesystem graphically via ranger, cd-ing into the chosen
# directory on exit (ranger can't change its parent shell's cwd itself)
goto() {
    local tempfile
    tempfile=$(mktemp)
    ranger --choosedir="$tempfile" "${@:-$PWD}"
    if [ -f "$tempfile" ] && [ -s "$tempfile" ]; then
        cd "$(cat "$tempfile")"
    fi
    rm -f "$tempfile"
}

########################################
# machine-local overrides
########################################
# aliases2 is gitignored on purpose - put anything here that's specific to
# this machine and shouldn't be shared to the others via this repo.
[ -f "${DOTFILES}/zsh/aliases2" ] && source "${DOTFILES}/zsh/aliases2"
