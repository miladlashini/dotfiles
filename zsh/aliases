# aliases - personal zsh aliases/functions, shared across every machine
# this dotfiles repo is used on. Sourced by .zshrc. Machine-specific
# additions that shouldn't be shared belong in aliases2 instead (see the
# bottom of this file) - that file is gitignored on purpose.
#
# Naming: everything below is lower_snake_case, matching install.sh,
# zsh/yocto, and scripts/Bash/history-sync - the convention the Google
# Shell Style Guide recommends and the one already dominant in this repo.
# Exception: the global aliases (`alias -g`) stay UPPERCASE on purpose,
# since that's the standard zsh idiom for making them visually stand out
# anywhere in a command line, not just as the first word.

########################################
# core dumps
########################################
# `ulimit -c unlimited` is set globally in .zshrc; if core files still
# aren't produced, it's usually one of:
#
# 1. /proc/sys/kernel/core_pattern starts with '|' - the kernel pipes core
#    dumps to that command instead of writing a file. Check its content and,
#    if needed, point it at a real directory instead (create the directory
#    first): set_core_dump_pattern below does this.
#
# 2. /etc/security/limits.conf is missing "soft core unlimited" - add it,
#    then log out and back in.

alias core_dump_status="ulimit -a"
alias set_core_dump_pattern="sudo bash -c 'echo $HOME/Documents/CoreFiles/core.%e.%p > /proc/sys/kernel/core_pattern'"

