########################################
# RPC project builds
########################################
# All quoted with '...' rather than "..." so $CC/$CXX/$RPC_*_DIR/$(nproc)
# are evaluated when the alias/function *runs*, not once at shell startup -
# otherwise switching $CC/$CXX mid-session (see .zshenv) would silently be
# ignored by these.
#
# Everything below uses `cmake --build "$RPC_BUILD_DIR" ...` rather than a
# bare `make`, and "${RPC_BUILD_DIR:?...}"/"${RPC_SOURCE_DIR:?...}" rather
# than a bare $RPC_BUILD_DIR/$RPC_SOURCE_DIR:
#   - bare `make`/`make clean` operate on whatever directory you happen to
#     be sitting in, not $RPC_BUILD_DIR - run from anywhere else and it
#     silently no-ops (or acts on an unrelated Makefile, if your CWD has
#     one). `cmake --build <dir>` is directory-explicit regardless of CWD.
#   - if $RPC_BUILD_DIR were ever unset/empty (e.g. this file sourced
#     without .zshenv having run), `rm -rf "$RPC_BUILD_DIR"/*` in clean_rpc
#     below would silently become `rm -rf /*`. The ":?" guard turns that
#     into an immediate, clear error instead.

alias build_rpc='cmake -D CMAKE_C_COMPILER="$CC" -D CMAKE_CXX_COMPILER="$CXX" -D RPC_WITH_TESTS:BOOL=ON -D CMAKE_VERBOSE_MAKEFILE=On -D CMAKE_BUILD_TYPE=Release -S "${RPC_SOURCE_DIR:?not set}" -B "${RPC_BUILD_DIR:?not set}" && cmake --build "$RPC_BUILD_DIR" -j"$(nproc)"'

# Shared implementation behind the build_rpc_* family below, which is every
# combination of build type x compiler x tests x clang-tidy (3x2x2x2 = 24).
# Every build_rpc_* name still works exactly as before; only the 24x
# duplicated cmake invocation underneath it was collapsed into this one
# function. Args: build_type with_clang with_tests with_tidy.
_rpc_build() {
    local build_type="$1" with_clang="$2" with_tests="$3" with_tidy="$4"
    : "${RPC_SOURCE_DIR:?RPC_SOURCE_DIR is not set}" "${RPC_BUILD_DIR:?RPC_BUILD_DIR is not set}"
    time cmake --build "$RPC_BUILD_DIR" --target clean && cmake -D CMAKE_VERBOSE_MAKEFILE=On \
        -D RPC_COMPILE_WITH_CLANG:BOOL="$with_clang" \
        -D RPC_WITH_TESTS:BOOL="$with_tests" \
        -D WITH_CLANG_TIDY:BOOL="$with_tidy" \
        -D CMAKE_BUILD_TYPE="$build_type" \
        -S "$RPC_SOURCE_DIR" -B "$RPC_BUILD_DIR" \
        && time cmake --build "$RPC_BUILD_DIR" -j"$(nproc)"
}

