# examples on/off (RPC_WITH_EXAMPLES sticks in the CMake cache, hence an
# explicit ON and OFF pair instead of relying on the option's default):
# _examples builds everything including the example programs and their extra
# deps (glog, udev, libusb, dbus, audio, protobuf), _core just library+tests.
# Note the examples' extra deps are not in the SDK target sysroot, so in a
# cross shell the _examples variants will fail at configure - build_rpc_core
# is the cross-appropriate one (and matches what the rpc recipe builds).
alias build_rpc_examples='_rpc_build Debug OFF ON OFF -DRPC_WITH_EXAMPLES=ON'
alias build_rpc_examples_r='_rpc_build Release OFF ON OFF -DRPC_WITH_EXAMPLES=ON'
alias build_rpc_examples_clang='_rpc_build Debug ON ON OFF -DRPC_WITH_EXAMPLES=ON'
alias build_rpc_examples_clang_r='_rpc_build Release ON ON OFF -DRPC_WITH_EXAMPLES=ON'
alias build_rpc_core='_rpc_build Debug OFF ON OFF -DRPC_WITH_EXAMPLES=OFF'

# ctest passthrough works: test_rpc -R BinaryQueue, test_rpc -j"$(nproc)", ...
# Guarded in a cross shell: ctest would try to exec ARM test binaries on this
# x86 host and every test would "fail" with an exec format error, which looks
# like a broken build rather than the category error it actually is.
test_rpc() {
    _rpc_is_cross && { _rpc_no_target_exec test_rpc; return 1; }
    ctest --test-dir "${RPC_BUILD_DIR:?not set}" --output-on-failure "$@"
}

# skip the (slow, valgrind-based) memcheck steps
test_rpc_fast() {
    _rpc_is_cross && { _rpc_no_target_exec test_rpc_fast; return 1; }
    ctest --test-dir "${RPC_BUILD_DIR:?not set}" --output-on-failure -E "\-memcheck" "$@"
}

# tolerate a missing example dir: cross builds use RPC_WITH_EXAMPLES=OFF, so
# Utils/example never gets created there and a bare find would just error out.
list_rpc_examples() {
    local dir="${RPC_BUILD_DIR:?not set}/Utils/example"
    [[ -d "$dir" ]] || { echo "no examples in $RPC_BUILD_DIR (built with RPC_WITH_EXAMPLES=OFF?)" >&2; return 1; }
    find "$dir" -type f -perm -u+x -not -path "*CMakeFiles*" | sort
}

# run an example binary by target name from anywhere: run_rpc_example TimeStamp [args...]
run_rpc_example() {
    _rpc_is_cross && { _rpc_no_target_exec run_rpc_example; return 1; }
    local name="${1:?usage: run_rpc_example <name> [args...]}"
    shift
    local exe
    exe="$(find "${RPC_BUILD_DIR:?RPC_BUILD_DIR is not set}/Utils/example" -type f -perm -u+x -not -path "*CMakeFiles*" -name "$name" | head -1)"
    [ -n "$exe" ] || { echo "run_rpc_example: no example named '$name' (see list_rpc_examples)" >&2; return 1; }
    "$exe" "$@"
}

# Safe in both shells: both act on $RPC_BUILD_DIR, which bbsdkenv has already
# repointed at the cross build dir, so these clean the tree you're working in.
alias clean_rpc='rm -rf "${RPC_BUILD_DIR:?not set}"/*'
alias clean_cmake_cache='rm -rf "${RPC_BUILD_DIR:?not set}/CMakeCache.txt" "$RPC_BUILD_DIR/CMakeFiles"'
alias list_targets='cmake --build "${RPC_BUILD_DIR:?not set}" --target help'

# ccache is host-only infrastructure: the SDK's cross compiler is invoked by
# absolute path, not through the /usr/lib/ccache symlinks, so these three stay
# host-global in every shell. Harmless in a cross shell, just not related to it.
alias clean_ccache='ccache -C'
alias ccache_stats='ccache -s'
alias update_ccache='sudo update-ccache-symlinks'  # run after installing a new compiler

# dpkg only knows about host packages, so in a cross shell it would report the
# host's boost while the build is actually linking the SDK sysroot's copy.
boost_version() {
    if _rpc_is_cross; then
        local hpp="$SDKTARGETSYSROOT/usr/include/boost/version.hpp"
        [[ -r "$hpp" ]] || { echo "boost not found in $SDKTARGETSYSROOT" >&2; return 1; }
        # anchor on the #define: version.hpp also has a *comment* mentioning
        # BOOST_LIB_VERSION, which an unanchored grep would match too.
        echo "Version: $(grep '^#define BOOST_LIB_VERSION' "$hpp" | awk '{print $3}' | tr -d '"' | tr '_' '.') (target sysroot)"
    else
        dpkg -s libboost-dev | grep 'Version'
    fi
}
